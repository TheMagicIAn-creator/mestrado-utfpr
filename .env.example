@'
# ========================
# PROVEDORES DE LLM
# ========================
# O projeto usa multi-provedor. Configure pelo menos uma chave.

# Google Gemini (gratuito)
GOOGLE_API_KEY=sua_chave_gemini_aqui

# Groq (gratuito - LLaMA 3.3 70B, LLaMA 3.1 8B, Gemma 2 9B)
GROQ_API_KEY=sua_chave_groq_aqui

# ========================
# CONFIGURACOES DO AGENTE
# ========================
NOME_AGENTE=Al IAdo PV
IDIOMA=portugues brasileiro
'@ | Set-Content -Path .env.example -Encoding UTF8