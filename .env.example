# ========================
# PROVEDORES DE LLM
# ========================
# O projeto usa multi-provedor. Configure pelo menos uma chave.

# Google Gemini principal (gemini-2.5-pro) — conversa e síntese final
GOOGLE_API_KEY=sua_chave_gemini_aqui

# Groq (llama-3.3-70b-versatile) — auditoria e memória
GROQ_API_KEY=sua_chave_groq_aqui

# Opções do plano/modelo contratado. Os padrões já são amplos; descomente
# apenas para trocar modelo, criatividade, saída, fuso ou orçamento do RAG.
# Modelo principal de conversa (o mais capaz):
# AL_IADO_GEMINI_MODEL=gemini-2.5-pro
# Modelo econômico do Gemini para tarefas de fundo (metadados de PDF, memória):
# AL_IADO_GEMINI_MODEL_FUNDO=gemini-2.5-flash
# AL_IADO_GROQ_MODEL=llama-3.3-70b-versatile
# AL_IADO_GEMINI_TEMPERATURE=0.45
# AL_IADO_GEMINI_MAX_OUTPUT_TOKENS=8192
# AL_IADO_TIMEZONE=America/Sao_Paulo
# AL_IADO_RAG_MAX_PROMPT_CHARS=180000
# AL_IADO_RAG_CONTEXTO_CHARS=40000
# AL_IADO_RAG_OBSIDIAN_CHARS=18000

# ========================
# CONSOLIDACAO DE MEMORIA
# ========================
# Gatilhos de consolidacao de sessoes (consolidar_memoria.py)
CONSOLIDAR_LIMITE_INTERACOES=15
CONSOLIDAR_DIAS_ACUMULACAO=3

# ========================
# INDEXACAO DE LITERATURA
# ========================
# Tamanho/sobreposicao dos chunks de PDFs (indexador.py).
# 500 chars era o valor antigo; 1600-2200 e mais equilibrado para RAG academico.
TAMANHO_CHUNK_LITERATURA=1800
SOBREPOSICAO_LITERATURA=200
# Extracao de tabelas via pdfplumber na indexacao (0=desligado, 1=ligado).
# Ligado deixa a reindexacao bem mais lenta.
EXTRAIR_TABELAS_LITERATURA=0

# Caminhos opcionais para testes/deploy. Quando omitidos, usam
# base_conhecimento/ e artefatos/literatura_indexada.jsonl.gz na raiz.
# AL_IADO_CHROMADB_DIR=/caminho/temporario/chromadb
# AL_IADO_INDICE_LITERATURA=/caminho/literatura_indexada.jsonl.gz
# AL_IADO_INDICE_OBSIDIAN=/caminho/obsidian_indexado.jsonl.gz
# AL_IADO_INDICE_LEXICAL=/caminho/literatura_fts.sqlite3
# Memoria validada: no PC pode ser versionada com o repositorio. No Streamlit
# Community Cloud, novas gravacoes duram ate o proximo redeploy/reinicio.
# AL_IADO_MEMORIA_DIR=/caminho/memorias_agentes
# AL_IADO_MEMORIA_VALIDADA=/caminho/memoria_validada.json
# Raiz do vault pesquisável. Todo Markdown útil entra por padrão; diretórios
# técnicos e notas com al_iado:false ou privado:true ficam de fora.
# AL_IADO_OBSIDIAN_VAULT_DIR=/caminho/vault
# Subpasta de memória validada/curada (normalmente <vault>/Cerebro).
# AL_IADO_OBSIDIAN_DIR=/caminho/vault/Cerebro
# AL_IADO_DATASET_PADERBORN=/caminho/Inverter_Data_Set.csv
# Backend auto: ONNX no site em modo consulta; SentenceTransformer no PC.
# AL_IADO_EMBEDDINGS_BACKEND=auto
# AL_IADO_ONNX_THREADS=1

# ========================
# EXPERIMENTOS DE ML (avancado)
# ========================
# Roda experimentos por artigo sem subprocesso isolado (debug apenas).
# AL_IADO_SEM_ISOLAMENTO=1
# Marcador interno do processo filho de experimento - NAO definir manualmente.
# AL_IADO_EXP_CHILD=1
