# Chave unica da equipe Gemini. Nunca versione o valor real.
GOOGLE_API_KEY=sua_chave_gemini_aqui

# Aplicacao ASGI: `python -m src.webapp`.
# AL_IADO_HOST=127.0.0.1
# PORT=8000
# AL_IADO_LOG_LEVEL=info
# Console e o destino padrao. Ligue o arquivo rotativo apenas quando necessario.
# AL_IADO_LOG_FILE=0
# AL_IADO_BUILD_LABEL=canonico-local
# AL_IADO_TIMEZONE=America/Sao_Paulo

# Rede corporativa com inspecao TLS: usa a loja de certificados do sistema sem
# desabilitar a verificacao.
# AL_IADO_CERT_SISTEMA=1

# Modelos Gemini e limites de chamada.
# AL_IADO_GEMINI_MODEL=gemini-3.6-flash
# AL_IADO_GEMINI_MODEL_AUDITOR=gemini-3.5-flash-lite
# AL_IADO_GEMINI_MODEL_FUNDO=gemini-3.5-flash-lite
# AL_IADO_GEMINI_FALLBACK=gemini-3.5-flash
# AL_IADO_GEMINI_ALTERNATIVO=gemini-3.5-flash-lite
# AL_IADO_GEMINI_THINKING_LEVEL=low
# AL_IADO_GEMINI_THINKING_LEVEL_AUDITOR=minimal
# AL_IADO_GEMINI_THINKING_LEVEL_FUNDO=minimal
# AL_IADO_GEMINI_RETENTATIVAS=2
# AL_IADO_GEMINI_BACKOFF_S=1.2
# AL_IADO_GEMINI_TEMPERATURE=0.45
# AL_IADO_GEMINI_MAX_OUTPUT_TOKENS=8192

# Orcamento do RAG. Os demais limites AL_IADO_RAG_* seguem as chaves de
# ORCAMENTOS_RAG em src/conhecimento/agente.py.
# AL_IADO_RAG_MAX_PROMPT_CHARS=180000
# AL_IADO_RAG_CONTEXTO_CHARS=40000
# AL_IADO_RAG_OBSIDIAN_CHARS=18000

# Base vetorial, snapshots portateis e vault.
# AL_IADO_CHROMADB_DIR=/caminho/local/chromadb
# AL_IADO_INDICE_LITERATURA=/caminho/literatura_indexada.jsonl.gz
# AL_IADO_INDICE_OBSIDIAN=/caminho/obsidian_indexado.jsonl.gz
# AL_IADO_INDICE_LEXICAL=/caminho/literatura_fts.sqlite3
# AL_IADO_OBSIDIAN_VAULT_DIR=/caminho/vault
# AL_IADO_OBSIDIAN_DIR=/caminho/vault/Cerebro
# AL_IADO_MEMORIA_DIR=/caminho/memorias_agentes
# AL_IADO_MEMORIA_VALIDADA=/caminho/memoria_validada.json
# AL_IADO_OBSIDIAN_SYNC_INTERVAL_S=300
# AL_IADO_INDEX_LOCK_PATH=/caminho/chromadb-index.lock
# AL_IADO_INDEX_LOCK_TIMEOUT_S=180
# AL_IADO_EMBEDDINGS_BACKEND=auto
# AL_IADO_ONNX_THREADS=1

# Indexacao academica.
TAMANHO_CHUNK_LITERATURA=1800
SOBREPOSICAO_LITERATURA=200
EXTRAIR_TABELAS_LITERATURA=0

# Memoria validada e persistencia opcional em implantacao com disco efemero.
CONSOLIDAR_LIMITE_INTERACOES=15
CONSOLIDAR_DIAS_ACUMULACAO=3
# AL_IADO_CONSOLIDAR_A_CADA=6
# AL_IADO_PERSISTIR_NUVEM=0
# GITHUB_TOKEN=seu_token_github_aqui
# AL_IADO_GITHUB_TOKEN=alternativa_ao_GITHUB_TOKEN
# AL_IADO_GITHUB_REPO=TheMagicIAn-creator/mestrado-utfpr
# AL_IADO_GITHUB_BRANCH=main
# AL_IADO_GITHUB_TIMEOUT=12

# Unico dataset cientifico ativo: os 16 CSVs F0L-F7M do GPVS-Faults.
# AL_IADO_DATASET_GPVS=/caminho/gpvs/csv/CSV_Files
