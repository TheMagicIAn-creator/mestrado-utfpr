# ========================
# REDE CORPORATIVA (proxy com inspeção TLS)
# ========================
# Ligue em máquina cuja rede reassina TLS (proxy corporativo). Faz o Python
# usar a loja de certificados do SISTEMA, onde está o raiz da empresa, em vez
# do bundle do certifi. A verificação continua ATIVA — isto resolve a
# confiança, não a desliga.
# Sintoma sem isto: baixar o modelo de embeddings falha com
# "[SSL: CERTIFICATE_VERIFY_FAILED] self-signed certificate in certificate chain".
# AL_IADO_CERT_SISTEMA=1

# ========================
# PROVEDORES DE LLM
# ========================
# Equipe 100% Gemini — uma única chave atende os três níveis de modelo.

# Google Gemini — conversa (pro), auditoria (flash) e fundo (flash-lite)
GOOGLE_API_KEY=sua_chave_gemini_aqui

# Modelos por nível. Padrão = aliases -latest, que sempre apontam para a versão
# vigente (a família 2.5 foi aposentada em 2026; fixar número quebra). Descomente
# só para fixar/trocar. Se um modelo sumir (404) ou sobrecarregar (503), o app
# cai no fallback sozinho.
# Nível 1 — conversa/síntese/imagens. Padrão gemini-flash-latest (GA, estável).
# Para MÁXIMO raciocínio, troque para gemini-pro-latest (mais lento, sujeito a 503):
# AL_IADO_GEMINI_MODEL=gemini-flash-latest
# Nível 2 — auditor de evidências e porteiro da memória:
# AL_IADO_GEMINI_MODEL_AUDITOR=gemini-flash-latest
# Nível 3 — tarefas de fundo (metadados de PDF, consolidação de memória):
# AL_IADO_GEMINI_MODEL_FUNDO=gemini-flash-lite-latest
# AL_IADO_BUILD_LABEL=2026-08-05 · identificacao do deploy
# AL_IADO_INDEX_LOCK_PATH=C:/caminho/local/chromadb-index.lock
# Espera maxima por uma indexacao concorrente, em segundos (padrao 180).
# Aumente se o acervo for grande: reprocessar a literatura inteira pode
# segurar o lock por mais que o padrao, e o segundo processo desiste com
# TimeoutError em vez de esperar.
# AL_IADO_INDEX_LOCK_TIMEOUT_S=180
# Fallback GA quando o modelo configurado estiver indisponível (404):
# AL_IADO_GEMINI_FALLBACK=gemini-flash-latest
# Modelo ALTERNATIVO (pool diferente) para escapar de 503 do Flash sobrecarregado:
# AL_IADO_GEMINI_ALTERNATIVO=gemini-flash-lite-latest
# Retentativas e backoff (s) em erro transitório (503 alta demanda / 429 limite):
# AL_IADO_GEMINI_RETENTATIVAS=2
# AL_IADO_GEMINI_BACKOFF_S=1.2

# ========================
# PERSISTÊNCIA NA NUVEM (Streamlit Cloud)
# ========================
# O Streamlit Community Cloud tem disco efêmero: o que o agente aprende em
# runtime some no próximo redeploy. Com o switch abaixo LIGADO e um token do
# GitHub, a memória validada é commitada de volta ao repositório e sobrevive a
# redeploys. No PC deixe DESLIGADO (você versiona manualmente com git).
# AL_IADO_PERSISTIR_NUVEM=1
# Token do GitHub com permissão de escrita em conteúdo (fine-grained: Contents
# read/write; ou clássico com escopo 'repo'). NUNCA versione o valor real.
# GITHUB_TOKEN=seu_token_github_aqui
# AL_IADO_GITHUB_TOKEN=alternativa_ao_GITHUB_TOKEN
# Repositório alvo "owner/repo" (default: detectado de .git/config).
# AL_IADO_GITHUB_REPO=TheMagicIAn-creator/mestrado-utfpr
# Branch de deploy para onde a memória é commitada (default: main).
# AL_IADO_GITHUB_BRANCH=main
# Timeout (s) das chamadas à API do GitHub (default: 12).
# AL_IADO_GITHUB_TIMEOUT=12
# AL_IADO_GEMINI_TEMPERATURE=0.45
# AL_IADO_GEMINI_MAX_OUTPUT_TOKENS=8192
# AL_IADO_TIMEZONE=America/Sao_Paulo
# AL_IADO_RAG_MAX_PROMPT_CHARS=180000
# AL_IADO_RAG_CONTEXTO_CHARS=40000
# AL_IADO_RAG_OBSIDIAN_CHARS=18000

# ========================
# CONSOLIDACAO DE MEMORIA
# ========================
# Gatilhos de consolidacao de sessoes (consolidar_memoria.py)
CONSOLIDAR_LIMITE_INTERACOES=15
CONSOLIDAR_DIAS_ACUMULACAO=3
# Aprendizado automatico no chat web: a cada N interacoes o auditor extrai
# decisoes/preferencias duraveis para a memoria validada (independe do watcher).
# O MESMO N tambem comita a sessao web atual (notas/sessoes/*.md) no GitHub
# (se AL_IADO_PERSISTIR_NUVEM estiver ligado), para sobreviver a reboots.
# AL_IADO_CONSOLIDAR_A_CADA=6

# ========================
# INDEXACAO DE LITERATURA
# ========================
# Tamanho/sobreposicao dos chunks de PDFs (indexador.py).
# 500 chars era o valor antigo; 1600-2200 e mais equilibrado para RAG academico.
TAMANHO_CHUNK_LITERATURA=1800
SOBREPOSICAO_LITERATURA=200
# Extracao de tabelas via pdfplumber na indexacao (0=desligado, 1=ligado).
# Ligado deixa a reindexacao bem mais lenta.
EXTRAIR_TABELAS_LITERATURA=0

# Caminhos opcionais para testes/deploy. Quando omitidos, usam
# base_conhecimento/ e artefatos/literatura_indexada.jsonl.gz na raiz.
# AL_IADO_CHROMADB_DIR=/caminho/temporario/chromadb
# AL_IADO_INDICE_LITERATURA=/caminho/literatura_indexada.jsonl.gz
# AL_IADO_INDICE_OBSIDIAN=/caminho/obsidian_indexado.jsonl.gz
# AL_IADO_INDICE_LEXICAL=/caminho/literatura_fts.sqlite3
# Memoria validada: no PC pode ser versionada com o repositorio. No Streamlit
# Community Cloud, novas gravacoes duram ate o proximo redeploy/reinicio.
# AL_IADO_MEMORIA_DIR=/caminho/memorias_agentes
# AL_IADO_MEMORIA_VALIDADA=/caminho/memoria_validada.json
# Raiz do vault pesquisável. Todo Markdown útil entra por padrão; diretórios
# técnicos e notas com al_iado:false ou privado:true ficam de fora.
# AL_IADO_OBSIDIAN_VAULT_DIR=/caminho/vault
# Subpasta de memória validada/curada (normalmente <vault>/Cerebro).
# AL_IADO_OBSIDIAN_DIR=/caminho/vault/Cerebro
# AL_IADO_DATASET_GPVS=/caminho/gpvs/csv/CSV_Files
# Backend auto: ONNX no site em modo consulta; SentenceTransformer no PC.
# AL_IADO_EMBEDDINGS_BACKEND=auto
# AL_IADO_ONNX_THREADS=1

# ========================
# EXPERIMENTOS DE ML (avancado)
# ========================
# Roda experimentos por artigo sem subprocesso isolado (debug apenas).
# AL_IADO_SEM_ISOLAMENTO=1
# Marcador interno do processo filho de experimento - NAO definir manualmente.
# AL_IADO_EXP_CHILD=1

# ========================
# ESCORE DE ANOMALIA (avancado)
# ========================
# Como o erro do Autoencoder vira um escore. "localizado" e o padrao e o
# metodo da dissertacao: media dos k maiores residuos padronizados por
# feature. "mse" volta ao MSE medio sobre TODAS as features - foi o que
# diluia falha concentrada em poucos canais e degenerava a Weibull
# (censura de 70% no IGBT e 98% no Fusivel AC). Trocar aqui muda o
# RESULTADO, nao so o desempenho: use apenas para reproduzir o antes/depois.
# AL_IADO_ESCORE_ANOMALIA=localizado
# Quantas features entram no escore localizado (k do top-k).
# AL_IADO_ESCORE_K=5
# Percentil do erro saudavel usado como limiar. Sem definir, o limiar e
# escolhido automaticamente pelo alvo de falso positivo abaixo.
# AL_IADO_ESCORE_PERCENTIL=99.0
# Alvo de falso positivo em %, quando o percentil nao e fixado.
#
# ATENCAO -- este alvo NAO e imposto, e uma PREFERENCIA entre candidatos.
# A busca testa cinco percentis (99,0 a 99,9) e escolhe o menor cujo FP fique
# abaixo do alvo; se NENHUM atinge, aceita o mais conservador assim mesmo.
# Hoje e o que acontece: p99,9 escolhido, FPR de ~10% no bloco de teste.
#
# Nao e defeito a corrigir baixando o corte: o FPR alto no teste vem de o bloco
# de teste estar em outro regime de F0 (mediana ~100 Hz contra ~51 Hz na
# calibracao), nao de limiar mal calibrado. Impor 1% derruba o recall do IGBT e
# do fusivel para ~0,025 e zera a Weibull por censura.
#
# Verifique com: python scripts/diagnostico_limiar.py
# Decisao registrada em: docs/decisao_fpr_1pct.md
# AL_IADO_ESCORE_FP_ALVO=1.0
# Semente do bootstrap que MEDE a incerteza do limiar (nao altera o limiar).
# AL_IADO_ESCORE_BOOTSTRAP_SEED=42

#
# O SPLIT do autoencoder (treino/calib/teste = 0,60/0,20/0,20) NAO tem env, de
# proposito: pipeline.py le essas constantes por AST sem importar o modulo, para
# registrar proveniencia sem torch. Com os.getenv() a leitura quebra, e ensinar o
# leitor a entender getenv faria o manifesto gravar o DEFAULT em vez do valor
# usado. Para varrer o split, edite src/ml/autoencoder.py e registre a rodada.

# ========================
# AE-LSTM (protocolo Ibrahim)
# ========================
# Passos temporais da janela deslizante do AE-LSTM.
# AL_IADO_AELSTM_SEQ_LEN=8
# Epocas de treino do AE-LSTM.
# AL_IADO_AELSTM_EPOCHS=60
